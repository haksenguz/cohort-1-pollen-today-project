# Deploy template for the Compose stack.
#
#   cp .env.example .env
#
# Compose reads `.env` from this directory automatically. The file is
# gitignored, so nothing here is ever committed. Fill in every REQUIRED value.
# The provider keys are allowed to stay blank: a missing key disables one
# feature and the UI says so, which is honest.
#
# The full walkthrough is in docs/DEPLOY.md.

# ---- required ---------------------------------------------------------------

# Public origin of the deployment, without a trailing slash. The frontend bakes
# it into its bundle at build time and Caddy uses it as the site address, so a
# wrong value here is a wrong URL in the client's network tab.
#   https://allergy.example.com   -> Caddy gets a real certificate
#   http://localhost               -> plain HTTP, for a local run
PUBLIC_ORIGIN=http://localhost

# Origins the browser may call the API from. A normal deploy is same origin,
# so the list can stay empty: the backend adds PUBLIC_ORIGIN to the allowlist
# by itself. Set it only when the API is served from a different origin than
# the site. It is a JSON array because the backend parses it as one.
CORS_ORIGINS=[]

# Signs every session token. Anyone who knows this value can sign a token for
# any user, so it has to be random and it has to differ from the example.
#   openssl rand -hex 32
JWT_SECRET=

# Postgres credentials. The password is required: Compose refuses to start
# without it, because a database with a guessable password on a public host is
# a database anyone can read.
POSTGRES_USER=allergy
POSTGRES_PASSWORD=
POSTGRES_DB=allergy_ai

# ---- provider keys ----------------------------------------------------------

# Who runs the app. The privacy policy names the operator, and Korean law
# (제30조) wants a business name and a 사업자등록번호 in it. Leave them blank
# and the policy says no operator is named and cannot be published.
OPERATOR_NAME=
OPERATOR_REGISTRATION_NUMBER=

# The LLM key and the base URL must come from the same provider. A key pointed
# at the wrong host answers 401 with a body that reads "Missing Authentication
# header" even while the SDK is sending the header correctly, so the message
# looks like a missing credential rather than a mismatched host.
#   MiniMax     OPENAI_BASE_URL=https://api.minimax.io/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI      leave OPENAI_BASE_URL blank
#
# Model IDs are provider-specific: MiniMax takes native IDs like
# `MiniMax-M3.1-Flash-Preview`, OpenRouter takes kebab-case route IDs like
# `minimax/minimax-m3`. A MiniMax ID on OpenRouter 404s.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Naver Local Search, for the hospital finder.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# KMA 꽃가루농도위험지수 serviceKey from data.go.kr. See
# docs/research/pollen-providers.md. Blank falls back to a flagged sample
# (pollen_is_sample: true in /api/environment/current).
POLLEN_API_KEY=

# ---- optional ---------------------------------------------------------------

# Where the edge listens. 0.0.0.0 for a public deployment, 127.0.0.1 when
# something else on the host terminates TLS in front of it.
PUBLIC_BIND=0.0.0.0

# "production" turns on the boot guard in backend/app/core/config.py, which
# refuses to start on an unsafe configuration. Set it to "development" only for
# a throwaway local run.
ENVIRONMENT=production
