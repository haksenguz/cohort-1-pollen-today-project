PORT=8000

# Slice C — Telegram
# Bot token from @BotFather. Ops chat is the private channel that receives
# job failures from Week 3 onward.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# Slice A — KMA pollen index via data.go.kr
