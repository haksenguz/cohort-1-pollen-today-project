# Copy to .env and fill in. .env is gitignored and must never be committed.

MONGODB_URI=mongodb://localhost:27017/pollen
PORT=8000

# Slice C — Telegram
# Bot token from @BotFather. With no token the sender logs instead of posting,
# so the whole pipeline can be exercised before the bot exists.
TELEGRAM_BOT_TOKEN=
# Private channel that receives job failures from Week 3 onward.
TELEGRAM_OPS_CHAT_ID=
# Region -> public channel, as JSON. Only listed regions are ever alerted.
# Region keys must match the Region enum in the SDL.
TELEGRAM_CHANNELS={"SEOUL":"@pollen_seoul"}

# Slice A — KMA pollen index via data.go.kr
# Service: HealthWthrIdxServiceV3 (getOakPollenRiskIdxV3 / getPinePollenRiskIdxV3 /
# weeds). Params: areaNo (see REGION_AREA_NO), time=YYYYMMDDHH, dataType=JSON.
# Limit 30 TPS. BLOCKED: key not yet issued — see OPEN_QUESTIONS.md §2.1
KMA_API_KEY=

# Alerts fire at or above this level. One of LOW|MODERATE|HIGH|VERY_HIGH.
# Provisional — mentor confirms the real threshold by Thu 3 Sep.
ALERT_MIN_RISK_LEVEL=HIGH
