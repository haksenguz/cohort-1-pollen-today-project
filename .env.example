# Backend
DATABASE_URL=postgresql+asyncpg://allergy:allergy@localhost:5432/allergy_ai
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me

# External services — server-side only, never expose in the frontend
#
# The chat agent talks to any OpenAI-compatible endpoint. `OPENAI_API_KEY` and
# `OPENAI_BASE_URL` MUST come from the same provider: a key pointed at the wrong
# host fails with a 401 whose body reads "Missing Authentication header" even
# though the SDK is sending the header correctly. That message is a
# provider-mismatch symptom, not a missing credential.
#
#   MiniMax     OPENAI_BASE_URL=https://api.minimax.io/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI      leave OPENAI_BASE_URL blank
#
# Model IDs are provider-specific: MiniMax takes native IDs like
# `MiniMax-M3.1-Flash-Preview`, OpenRouter takes kebab-case route IDs like
# `minimax/minimax-m3`. A MiniMax ID on OpenRouter 404s.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# KMA 꽃가루농도위험지수 (pollen concentration risk index) serviceKey from
# data.go.kr — see docs/research/pollen-providers.md. Blank falls back to a
# flagged sample (pollen_is_sample: true in /api/environment/current).
POLLEN_API_KEY=
WEATHER_API_KEY=

# Frontend (Vite — only VITE_-prefixed vars reach the client bundle.
# This belongs in frontend/.env, not the repo-root .env. The Next.js-style
# NEXT_PUBLIC_ prefix does nothing here; it was in this file until 2026-10-16
# and silently had no effect.)
VITE_API_BASE_URL=http://localhost:8000
