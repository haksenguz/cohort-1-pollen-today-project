# Backend
DATABASE_URL=postgresql+asyncpg://allergy:allergy@localhost:5432/allergy_ai
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me

# External services — server-side only, never expose in the frontend
OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# KMA 꽃가루농도위험지수 (pollen concentration risk index) serviceKey from
# data.go.kr — see docs/research/pollen-providers.md. Blank falls back to a
# flagged sample (pollen_is_sample: true in /api/environment/current).
POLLEN_API_KEY=
WEATHER_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
