# Copy to .env and fill in. .env is gitignored.
#
# --- Database -----------------------------------------------------------
# Postgres 14+ is required. The default below expects a local install
# created by `docker compose up` or the team's dev script.
DATABASE_URL=postgresql+asyncpg://allergy:allergy@localhost:5432/allergy_ai
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------
# 32+ random chars. The default is a placeholder that fails healthchecks
# in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-32-or-more-random-chars

# --- External services (I3) ---------------------------------------------
# All keys are server-side only. Never expose them to the frontend.
#
# OpenAI — used by the symptom agent. Without it /api/chat returns a
# stream error and the agent extracts nothing, so the user never
# reaches a verdict. See TASKS.md J2.
#   Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint (OpenRouter, Azure,
# a local proxy). Leave blank for OpenAI's own endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# J6 cost + latency guard. 0 means "use the built-in default" (512 output
# tokens, 20s per call). See app/core/openai_client.py.
OPENAI_MAX_TOKENS=0
OPENAI_TIMEOUT_SECONDS=0
#
# Naver Local Search — used by /api/hospitals/nearby. Without it the
# endpoint answers provider_available: false and the Today screen
# shows a 'add the Naver keys' note.
#   Sign up: https://www.ncloud.com/
#   Enable  : Naver Cloud Platform → Services → AI·NAVER API → Maps →
#             Local → 사용 신청 (Application). Both Application
#             Registration (client id + secret) and the Local Search
#             API itself must be approved.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
#
# Pollen (data.go.kr) — KMA 꽃가루농도위험지수 (pollen concentration
# risk index). Without it /api/environment/current still answers, but the
# Today screen shows "Pollen: Unavailable" rather than inventing numbers.
# This is the one remaining key (TASKS.md I3).
#   Get one   : https://www.data.go.kr/ → search
#                "꽃가루농도위험지수" → 활용신청 → 발급 (Decoding key).
#   Reference : docs/research/pollen-providers.md.
POLLEN_API_KEY=
#
# --- Abuse protection ---------------------------------------------------
# Per-user limit on POST /api/chat, in requests per rolling minute. Each
# turn is a real model call, so this is a billing control, not just tidiness.
# 0 disables limiting (local dev / the test suite). See app/core/rate_limit.py.
CHAT_RATE_LIMIT_PER_MINUTE=20
