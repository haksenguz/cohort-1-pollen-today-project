# Local backend development. Copy to backend/.env:
#
#   cd backend && cp .env.example .env
#
# The backend reads `.env` from the directory it runs in, so this file lives
# next to the app, not at the repository root. The repository-root `.env` is
# the Compose deploy template and is a different file with a different job.
#
# The dev credential route stays off here. It is unauthenticated and it reads
# and writes the provider keys in this file.

DATABASE_URL=postgresql+asyncpg://allergy:allergy@localhost:5432/allergy_ai
REDIS_URL=redis://localhost:6379

# Signs session tokens locally. Any long random string. Never reuse the deploy
# value, so a leaked local token says nothing about the deployed instance.
JWT_SECRET=change-me

# Origins the browser may call the API from. The Vite dev server and its
# preview server, both on their default ports.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# The LLM key and the base URL must come from the same provider. A key pointed
# at the wrong host answers 401 with a body that reads "Missing Authentication
# header" even while the SDK is sending the header correctly, so the message
# looks like a missing credential rather than a mismatched host.
#   MiniMax     OPENAI_BASE_URL=https://api.minimax.io/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI      leave OPENAI_BASE_URL blank
#
# Model IDs are provider-specific: MiniMax takes native IDs like
# `MiniMax-M3.1-Flash-Preview`, OpenRouter takes kebab-case route IDs like
# `minimax/minimax-m3`. A MiniMax ID on OpenRouter 404s.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Naver Local Search, for the hospital finder.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# KMA 꽃가루농도위험지수 serviceKey from data.go.kr. See
# docs/research/pollen-providers.md. Blank falls back to a flagged sample.
POLLEN_API_KEY=

# Exposes an unauthenticated route that reads and writes the provider keys
# above. Local development only.
DEV_SETTINGS_ENABLED=false
