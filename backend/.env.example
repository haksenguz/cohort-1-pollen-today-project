# Copy to .env and fill in. .env is gitignored.
#
# --- Database -----------------------------------------------------------
# Postgres 14+ is required. The default below expects a local install
# created by `docker compose up` or the team's dev script.
DATABASE_URL=postgresql+asyncpg://allergy:allergy@localhost:5432/allergy_ai
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------
# 32+ random chars. The default is a placeholder that fails healthchecks
# in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-32-or-more-random-chars

# --- External services (I3) ---------------------------------------------
# All keys are server-side only. Never expose them to the frontend.
#
# OpenAI-compatible endpoint — used by the symptom agent. Without a working
# key /api/chat returns a stream error and the agent extracts nothing, so the
# user never reaches a verdict.
#
# A key is only valid against the host that issued it. Pairing a MiniMax key
# with OPENAI_BASE_URL=https://openrouter.ai/api/v1 produces a misleading
# "Missing Authentication header" from OpenRouter on every call, and the app
# silently answers with a hardcoded string (see B-007 in bugs.md).
#   OpenAI     : key from https://platform.openai.com/api-keys,
#                base URL https://api.openai.com/v1
#   MiniMax    : key from https://platform.minimax.io, base URL below
#   OpenRouter : key from https://openrouter.ai, base URL https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.io/v1
OPENAI_MODEL=
#
# Local dev only. When true, /api/dev/llm can read and write the three keys
# above in this file, so the browser can change the model without a restart.
# It exposes a route that writes this instance's credentials, so leave it false
# everywhere except a gitignored local .env — never in a deploy.
DEV_SETTINGS_ENABLED=false
#
# Naver Local Search — used by /api/hospitals/nearby. Without it the
# endpoint answers provider_available: false and the Today screen
# shows a 'add the Naver keys' note.
#   Sign up: https://www.ncloud.com/
#   Enable  : Naver Cloud Platform → Services → AI·NAVER API → Maps →
#             Local → 사용 신청 (Application). Both Application
#             Registration (client id + secret) and the Local Search
#             API itself must be approved.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
#
# Pollen (data.go.kr) — KMA 꽃가루농도위험지수 (pollen risk index). Without
# it /api/environment/current reports no pollen at all and the Today screen
# shows an 'unavailable' row. With a key that is outside KMA's data window
# (tree pollen is served 3-6월, weeds 8-10월) the result is the same, and that
# is correct rather than a misconfiguration.
#   Get one   : https://www.data.go.kr/ → search
#                "꽃가루농도위험지수" → 활용신청 → 발급 (Decoding key).
#   Check it : uv run python -m scripts.verify_live_pollen
#   Reference : docs/research/pollen-providers.md.
POLLEN_API_KEY=
#
# WEATHER_API_KEY is dead config (nothing reads it) — see the parking
# lot in TASKS.md. Leave blank.
WEATHER_API_KEY=
