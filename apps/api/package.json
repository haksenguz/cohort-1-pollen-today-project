{
  "name": "@pollen/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "schema:generate": "tsc src/scripts/generate-typings.ts --outDir dist-tools --module commonjs --moduleResolution node --target ES2022 --esModuleInterop --skipLibCheck && node dist-tools/generate-typings.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^4.11.2",
    "@nestjs/apollo": "^12.2.1",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/graphql": "^12.2.1",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.1",
    "@pollen/contracts": "workspace:*",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.25.0",
    "mongoose": "^8.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.1",
    "ts-morph": "^24.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
